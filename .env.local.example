# Copy this file to ".env.local" and fill in the values from your Supabase
# dashboard: Project Settings -> API.
#
#   Project URL      -> NEXT_PUBLIC_SUPABASE_URL
#   anon public key  -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# The anon key is safe to expose to the browser. Do NOT put the service_role
# key in a NEXT_PUBLIC_ variable — keep that one secret if you ever need it.

NEXT_PUBLIC_SUPABASE_URL=https://bmvcvwjqkgnyuldcvusm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# SECRET — server only. Needed for the admin "Create login" feature.
# Supabase dashboard -> Project Settings -> API Keys -> service_role / secret.
# NEVER prefix this with NEXT_PUBLIC_ and never share it publicly.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
